{
  "manifest_version": 3,
  "name": "Gmail: скачать письмо в PDF",
  "version": "1.0.0",
  "description": "Добавляет в Gmail кнопку для сохранения открытого письма в PDF.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["print.css"],
      "run_at": "document_idle"
    }
  ]
}
