# Токен бота из @BotFather: нужен только для проверки подписи пользователя Mini App
BOT_TOKEN=

# Токен TMDB (API Read Access Token) с https://www.themoviedb.org/settings/api
# Без него работает только аниме (Shikimori)
TMDB_TOKEN=
# Регион для блока «Где посмотреть»
TMDB_REGION=RU

# Зеркало Shikimori, если основной домен недоступен
SHIKIMORI_URL=https://shikimori.io

# Через запятую: Telegram ID тех, кому открыт доступ. Пусто — открыто всем
ALLOWED_USER_IDS=

# Только для отладки в обычном браузере без Telegram. На сервере оставить пустым!
DEV_USER_ID=
